<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="r_env_vars" xml:lang="ja-JP">
  <title>環境変数</title>
  <shortdesc><keyword keyref="product"/>の実行に必要な環境変数の一覧です。</shortdesc>
  <refbody>
    <properties>
      <prophead>
        <proptypehd>変数名</proptypehd>
        <propvaluehd>設定例</propvaluehd>
        <propdeschd>説明</propdeschd>
      </prophead>
      <property>
        <proptype>DB_HOST</proptype>
        <propvalue>localhost</propvalue>
        <propdesc>データベースのホスト名。</propdesc>
      </property>
      <property>
        <proptype>APP_ENV</proptype>
        <propvalue>production</propvalue>
        <propdesc>実行環境。</propdesc>
      </property>
    </properties>
  </refbody>
</reference>